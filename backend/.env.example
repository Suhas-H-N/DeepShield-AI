# Copy this file to `.env` in the backend/ directory and fill in real values.
# Never commit the actual .env file.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# SQLite for local dev; use Postgres in production, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/deepshield
DATABASE_URL=sqlite:///./deepshield.db

# --- Uploads ---
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=200
UPLOAD_TEMP_DIR=/tmp/deepshield_uploads

# --- Rate limiting ---
RATE_LIMIT_DETECT=10/minute
RATE_LIMIT_AUTH=5/minute

# --- Model weights ---
# Directory containing trained checkpoints named <model_name>.pt
# (cnn.pt, efficientnet.pt, xception.pt, vit.pt). Leave empty/missing to
# run in demo mode with randomly-initialized weights.
MODEL_WEIGHTS_DIR=model_weights
